### CONFIGURACIÓN DE VARIABLES
@urlbase = http://localhost:3000
@urlhealth = {{urlbase}}/health
@urlAuth = {{urlbase}}/auth
@urlUser = {{urlbase}}/users
@urlSubjects = {{urlbase}}/subjects
@urlEnrollments = {{urlbase}}/enrollments

# NOTA: Para probar los endpoints que requieren ID, por favor copia un UUID
# generado al crear los usuarios o materias e insértalo en las variables de abajo:
